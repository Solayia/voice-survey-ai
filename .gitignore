# =============================================================================
# VoiceSurvey AI — .gitignore
# =============================================================================

# ----- OS / Editor -----------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json

# ----- Secrets / Environment -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/
*.local

# ----- Python / Backend ------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.hypothesis/

# ----- Node / Frontend -------------------------------------------------------
node_modules/
.next/
out/
.turbo/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo
.eslintcache
coverage/
playwright-report/
test-results/

# ----- Docker ----------------------------------------------------------------
*.pid

# ----- Logs / Temp -----------------------------------------------------------
logs/
*.log
tmp/
temp/
.cache/

# ----- Database / Data -------------------------------------------------------
*.sqlite
*.sqlite3
*.db
pgdata/
data/

# ----- Build artifacts / Misc ------------------------------------------------
*.bak
*.orig
