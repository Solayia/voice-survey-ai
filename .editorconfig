# EditorConfig — https://editorconfig.org
# Fichier EditorConfig racine pour VoiceSurvey AI
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python — PEP 8
[*.py]
indent_size = 4
max_line_length = 88

# Markdown — conserver les espaces de fin (sauts de ligne forcés)
[*.md]
trim_trailing_whitespace = false

# Les Makefiles exigent des tabulations
[Makefile]
indent_style = tab

# YAML / JSON / TS / JS / TSX / JSX / CSS / HTML
[*.{yml,yaml,json,js,jsx,ts,tsx,css,scss,html}]
indent_size = 2

# Scripts shell
[*.sh]
indent_size = 2
